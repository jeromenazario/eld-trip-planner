# Generate one: venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Set to False in production
DEBUG=False

# Keep as * or set to your Render domain
ALLOWED_HOSTS=*

# Google Cloud Console → APIs & Services → Credentials
# Enable: Geocoding API + Directions API
GOOGLE_MAPS_API_KEY=

# Your deployed Vercel frontend URL e.g. https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=
